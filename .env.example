NODE_ENV=development
PORT=3000

# Required
FIREBASE_PROJECT_ID=odivon-main-api-a2095

# Required for real Firebase (not needed when using emulators)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@odivon-main-api-a2095.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Local emulators (do not point these at production)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Extra browser origins (comma separated, no wildcard). The Odivon clients (hair/gym/vet/spa/rent/admin
# .odivon.com and their workers.dev hosts) and http://localhost:<port> are always allowed (src/config/cors.ts).
# CORS_ORIGIN=https://staging.example.com


# Hostinger SMTP Mail Configuration
# On Cloudflare Workers use the Hostinger Mail HTTPS API instead of SMTP.
# Create a token limited to info@odivon.com under Hostinger Agentic Mail > API.
# HOSTINGER_MAIL_API_TOKEN=your-hostinger-mail-api-token
# HOSTINGER_MAILBOX_RESOURCE_ID=ACxxxxxxxxxxxxxxxx
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@odivon.com
SMTP_PASS=your-mailbox-password
SMTP_FROM="OdivonGYM" <info@odivon.com>
APP_URL=https://gym.odivon.com
APP_URL_GYM=https://gym.odivon.com
APP_URL_VET=https://vet.odivon.com
APP_URL_SPA=https://spa.odivon.com
PUBLIC_API_URL=https://mainapi.odivon.com

# F-Gas production protection. Enable only after the frontend runtime config contains the
# matching reCAPTCHA Enterprise App Check site key.
FGAS_REQUIRE_APP_CHECK=false

# Never enable in production. When false, subscription activation is possible only after a
# server-verified live iyzico payment callback.
ALLOW_DEMO_BILLING=false

# Platform-owned SaaS subscription payment credentials (secrets in deployment, never Git).
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
PAYMENT_PUBLIC_BASE_URL=https://mainapi.odivon.com
PAYMENT_RETURN_ORIGINS=https://fgas.odivon.com,http://127.0.0.1:4210,http://localhost:4210

# Hair public booking: Cloudflare Turnstile secret (captcha is skipped when unset)
# TURNSTILE_SECRET=

# SMS (hair booking codes, confirmations, reminders). Set as Worker secrets, never in code.
# SMS_PROVIDER=netgsm
# NETGSM_USERCODE=
# NETGSM_PASSWORD=
# NETGSM_HEADER=YOURSENDER

# Hair scheduled jobs: POST /api/v1/hair/jobs/{run,reminders,expire-packages} need header X-Job-Secret.
# The Worker hourly cron calls the jobs directly; leave unset to keep the HTTP endpoints closed.
# HAIR_JOB_SECRET=
